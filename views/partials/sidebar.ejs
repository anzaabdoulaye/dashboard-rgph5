<!-- CSS SPÉCIFIQUE À LA SIDEBAR RGPH -->
<style>
    /* Fond de la sidebar avec un gradient vert profond */
    .rgph-sidebar {
        background: linear-gradient(180deg, #20be3d 0%, #20be3d 100%) !important;
        border-right: none !important;
        box-shadow: 4px 0 10px rgba(0,0,0,0.1);
    }
    
    /* Zone du logo */
    .sidebar-logo-box {
        background: rgba(0, 0, 0, 0.1) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    /* Titres de menu (ex: "Tableau de bord RGPH-5") */
    .rgph-sidebar .menu-title span {
        color: rgba(255, 255, 255, 0.5) !important;
        letter-spacing: 1px;
        font-weight: 600;
    }

    /* Style par défaut des liens */
    .rgph-sidebar .nav-link {
        color: rgba(255, 255, 255, 0.75) !important;
        font-size: 15px;
        margin: 5px 15px;
        padding: 10px 15px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    /* Icônes par défaut */
    .rgph-sidebar .nav-link i {
        color: rgba(255, 255, 255, 0.75) !important;
        font-size: 20px;
        transition: all 0.3s ease;
    }

    /* Effet au survol (Hover) */
    .rgph-sidebar .nav-link:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        transform: translateX(5px);
    }
    .rgph-sidebar .nav-link:hover i {
        color: #ffffff !important;
    }

    /* ETAT ACTIF : Style "Pill" blanc avec texte vert */
    .rgph-sidebar .nav-link.active {
        background: #ffffff !important;
        color: #20be3d !important;
        font-weight: 700;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
    .rgph-sidebar .nav-link.active i {
        color: #20be3d !important;
    }
</style>