<header id="page-topbar" class="shadow-sm">
    <div class="layout-width">
        <div class="navbar-header">
            <div class="d-flex align-items-center">
                <!-- LOGO -->
                <div class="navbar-brand-box horizontal-logo">
                    <!-- Remplacer par la logique d'images de logo -->
                    <a href="/" class="logo logo-dark">
                        <span class="logo-sm"><img src="/assets/images/logo-sm.png" alt="" height="22"></span>
                        <span class="logo-lg"><img src="/assets/images/logo-dark.png" alt="" height="17"></span>
                    </a>
                </div>

                <button type="button" class="btn btn-sm px-3 fs-24 header-item vertical-menu-btn topnav-hamburger text-dark material-shadow-none" id="topnav-hamburger-icon">
                    <i class="ri-menu-2-line"></i>
                </button>
            </div>

            <div class="d-flex align-items-center">
                <div class="dropdown ms-sm-3 header-item topbar-user">
                    <button type="button" class="btn material-shadow-none" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="d-flex align-items-center bg-light p-2 rounded">
                            <div class="avatar-xs me-2">
                                <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-16">
                                    <i class="ri-user-line"></i>
                                </span>
                            </div>
                            <span class="text-start">
                                <span class="d-block fw-bold text-dark fs-13 user-name-text">
                                    <%= user && user.nom ? user.nom.toUpperCase() : 'UTILISATEUR' %> <%= user && user.prenom ? user.prenom.toUpperCase() : '' %>
                                </span>
                                <span class="d-block fs-11 text-muted user-name-sub-text">
                                    <%= user && user.role ? user.role.substring(5) : '' %>
                                </span>
                            </span>
                            <i class="ri-arrow-down-s-line ms-2 text-muted"></i>
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2">
                        <h6 class="dropdown-header bg-light">Bienvenue</h6>
                        <a class="dropdown-item" href="#"><i class="ri-account-circle-line text-muted fs-16 align-middle me-2"></i> <span class="align-middle">Profil</span></a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-danger" href="auth/logout"><i class="ri-logout-box-r-line text-danger fs-16 align-middle me-2"></i> <span class="align-middle">Déconnexion</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>