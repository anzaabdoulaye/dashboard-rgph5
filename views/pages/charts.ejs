<script src="assets/libs/chart.js/chart.umd.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
  // SÉCURITÉ : SmartCache
        if (typeof SmartCache !== 'undefined') SmartCache.clear();

        const selects = {
            region: document.getElementById('region'),
            departement: document.getElementById('departement'),
            commune: document.getElementById('commune'),
            zs: document.getElementById('zs'),
            zd: document.getElementById('zd')
        };
        
        let charts = { pyramide: null, gender: null, progression: null,barRegions: null };
        const isActiveSelect = (element) => element && element.tagName === 'SELECT';

        const getSelectValue = (elementId) => {
            const element = document.getElementById(elementId);
            if (!element) return '';
            return element.value || ''; 
        };

        const optionsCache = {};
        
        // --- 2. INSTANCES CHART.JS ---

        // --- 3. UTILITAIRES ---
        const showLoader = () => {
            const loader = document.getElementById('globalLoader');
            if (loader) loader.style.display = 'flex';
        };

        const hideLoader = () => {
            const loader = document.getElementById('globalLoader');
            if (loader) loader.style.display = 'none';
        };

        function debounce(fn, delay = 200) {
            let timeout;
            return (...args) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => fn(...args), delay);
            };
        }

        // --- 4. CHARGEMENT DES OPTIONS (Cascading) ---
        async function loadOptions(url, select, valueField, textField) {
            if (!isActiveSelect(select)) return;

            const cacheKey = url;
            if (optionsCache[cacheKey]) {
                populateSelect(select, optionsCache[cacheKey], valueField, textField);
                return;
            }

            const currentValue = select.value;
            select.innerHTML = '<option value="" disabled selected>Chargement...</option>';
            select.disabled = false; 

            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                
                optionsCache[cacheKey] = data;
                populateSelect(select, data, valueField, textField);

                if (currentValue && data.some(item => item[valueField] === currentValue)) {
                    select.value = currentValue;
                }
            } catch (err) {
                console.error('Erreur loadOptions:', err);
                select.innerHTML = '<option value="">Erreur</option>';
            }
        }

        function populateSelect(select, data, valueField, textField) {
            select.innerHTML = '<option value="">-- Sélectionner --</option>';
            if (data && data.length > 0) {
                data.forEach(item => {
                    select.appendChild(new Option(item[textField], item[valueField]));
                });
            }
            select.disabled = false;
        }

        // --- 5. CHARGEMENT DES DONNÉES STATS (CORRIGÉ) ---
        async function fetchStats(paramsObj) {
            const cleanParams = {};
            Object.entries(paramsObj).forEach(([key, value]) => {
                if (value && value.trim() !== '') cleanParams[key] = value;
            });
            
            const queryString = new URLSearchParams(cleanParams).toString();
            // Ajout _t pour éviter le cache navigateur agressif
            const url = `/stats?${queryString}&_t=${Date.now()}`;
            
            try {
                const response = await fetch(url);
                const json = await response.json();
                return json;
            } catch (error) {
                console.error("Erreur fetch stats:", error);
                return null;
            }
        }

        async function updateCharts() {
            showLoader();
            try {
                const paramsObj = {
                    region: getSelectValue('region'),
                    departement: getSelectValue('departement'),
                    commune: getSelectValue('commune'),
                    zd: getSelectValue('zd')
                };
                console.log('📊 Charts - Paramètres:', paramsObj);

                // Appel API
                const url = `/stats?` + new URLSearchParams(Object.fromEntries(Object.entries(paramsObj).filter(([_, v]) => v))).toString();
                const response = await fetch(url);
                const data = await response.json();

                if (data) {
                    // Vérification des clés pour Pyramide
                    // Supporte les deux formats possibles (pyramideAges ou pyramideData)
                    const pyraData = data.pyramideAges || data.pyramideData || [];
                    const regiProg = data.regionStats || [];
                    console.log("Données Pyramide reçues:", pyraData.length, "entrées");
                    console.log("Données Progression reçues:", regiProg.length, "entrées");

                    
                    updatePyramideChart(pyraData);
                    updateGenderChart(data.populationStats || {});
                    updateProgressionChart(data.mainStats || {});
                    updatePopCollectéVsCartoRegion(regiProg);
                }
            } catch (err) {
                console.error('Erreur updateCharts:', err);
            } finally {
                hideLoader();
            }
        }

        const debouncedUpdateCharts = debounce(updateCharts, 300);

        // --- 6. LOGIQUE DES GRAPHIQUES (SÉCURISÉE) ---

        // A. Pyramide des Âges
        function updatePyramideChart(data) {
            const ctx = document.getElementById("chartPyramide");
            if (!ctx) return;

            // Protection contre undefined/null
            if (!Array.isArray(data) || data.length === 0) {
                console.warn("⚠️ Données Pyramide vides ou invalides", data);
                // On vide le graph s'il existe mais on ne plante pas
                if (charts.pyramide) {
                    charts.pyramide.data.datasets.forEach((dataset) => {
                        dataset.data = [];
                    });
                    charts.pyramide.update();
                }
                return;
            }

            // Mapping sécurisé
            const labels = data.map(d => d.age);
            const hommes = data.map(d => -Math.abs(d.hommes || 0)); 
            const femmes = data.map(d => Math.abs(d.femmes || 0));

            if (charts.pyramide) {
                charts.pyramide.data.labels = labels;
                charts.pyramide.data.datasets[0].data = hommes;
                charts.pyramide.data.datasets[1].data = femmes;
                charts.pyramide.update();
            } else {
                charts.pyramide = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Hommes',
                                data: hommes,
                                backgroundColor: 'rgba(18,165,55,0.8)',
                            },
                            {
                                label: 'Femmes',
                                data: femmes,
                                backgroundColor: 'rgba(242,143,0,0.8)',
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                stacked: true,
                                ticks: {
                                    callback: function(val) { return Math.abs(val); }
                                }
                            },
                            y: {
                                reverse: true,
                                stacked: true,
                                beginAtZero: true
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + Math.abs(context.raw);
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

        // B. Répartition par Sexe
        function updateGenderChart(stats) {
            const ctx = document.getElementById("genderChart");
            if (!ctx) return;
            
            // Protection valeurs par défaut
            const hommes = stats.hommes || 0;
            const femmes = stats.femmes || 0;

            if (charts.gender) {
                charts.gender.data.datasets[0].data = [hommes, femmes];
                charts.gender.update();
            } else {
                charts.gender = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Hommes', 'Femmes'],
                        datasets: [{
                            data: [hommes, femmes],
                            backgroundColor: ['#12A537', '#F28F00']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        }

        // C. Progression Collecte
        function updateProgressionChart(stats) {
            const ctx = document.getElementById("popChartPie");
            if (!ctx) return;

            // Protection valeurs par défaut
            const collectee = stats.collectee || 0;
            const carto = stats.cartographie || 0;
            const restant = Math.max(0, carto - collectee);
            const pCt = carto > 0 ? ((collectee / carto) * 100).toFixed(1) : 0;
            const pRAF = carto > 0 ? ((restant / carto) * 100).toFixed(1) : 0;

            if (charts.progression) {
                charts.progression.data.labels = [`Collectée (${pCt}%)`, `Reste à faire (${pRAF}%)`];
                charts.progression.data.datasets[0].data = [collectee, restant];
                charts.progression.update();
            } else {
                charts.progression = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: [`Collectée (${pCt}%)`, 'Reste à faire'],
                        datasets: [{
                            data: [collectee, restant],
                            backgroundColor: ['#12A537', '#F28F00']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        }
        
        // Remplacez la fonction updatePopCollectéVsCartoRegion par ceci :

function updatePopCollectéVsCartoRegion(dataArray) {
    const ctx = document.getElementById("popChartBarRegions");
    if (!ctx) return;

    // 1. Correction de la récupération des données
    // On reçoit directement le tableau, pas besoin de faire .regionStats
    const regionsData = Array.isArray(dataArray) ? dataArray : [];

    if (regionsData.length === 0) {
        console.warn("Pas de données régionales à afficher");
        return;
    }

    // 2. Préparation des labels et données
    const labelsRegions = regionsData.map(r => r.region);
    const cartoData = regionsData.map(r => r.carto);
    const collecteeData = regionsData.map(r => r.collectee);

    // 3. Gestion de la hauteur dynamique
    // On compte 60px par barre pour que ce soit lisible, avec un min de 300px
    const dynamicHeight = Math.max(300, regionsData.length * 60);
    
    // On applique la hauteur au conteneur PARENT et au Canvas
    ctx.parentNode.style.height = `${dynamicHeight}px`;
    ctx.height = dynamicHeight;

    // 4. Création ou Mise à jour du graphique
    // Si le graphique existe déjà, on le détruit pour éviter les bugs de redimensionnement vertical
    if (charts.barRegions) {
        charts.barRegions.destroy();
    }

    charts.barRegions = new Chart(ctx, {
        type: "bar",
        data: {
            labels: labelsRegions,
            datasets: [
                { 
                    label: "Cartographiée", 
                    data: cartoData, 
                    backgroundColor: "#12A537",
                    barPercentage: 0.7,
                    categoryPercentage: 0.8
                },
                { 
                    label: "Collectée", 
                    data: collecteeData, 
                    backgroundColor: "#F28F00",
                    barPercentage: 0.7,
                    categoryPercentage: 0.8
                }
            ]
        },
        options: {
            indexAxis: "y", // Barres horizontales
            responsive: true,
            maintainAspectRatio: false, // Indispensable pour le scroll vertical
            scales: {
                x: { 
                    beginAtZero: true,
                    grid: { display: true, drawBorder: false }
                },
                y: {
                    grid: { display: false }
                }
            },
            plugins: {
                legend: { position: "top" },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            // Formatage des milliers
                            return context.dataset.label + ": " + Number(context.raw).toLocaleString('fr-FR');
                        }
                    }
                }
            }
        }
    });
}
        // --- 7. LISTENERS ---
        if (isActiveSelect(selects.region)) {
            selects.region.addEventListener('change', async () => {
                if (isActiveSelect(selects.departement)) selects.departement.innerHTML = '<option value="">-- Sélectionner --</option>';
                if (isActiveSelect(selects.commune)) selects.commune.innerHTML = '<option value="">-- Sélectionner --</option>';
                if (isActiveSelect(selects.zs)) selects.zs.innerHTML = '<option value="">-- Sélectionner --</option>'; 
                if (isActiveSelect(selects.zd)) selects.zd.innerHTML = '<option value="">-- Sélectionner --</option>';

                if (selects.region.value) {
                    await loadOptions(`/api/location/departements?region=${selects.region.value}`, 
                                      selects.departement, 'code_departement', 'departement');
                }
                debouncedUpdateCharts();
            });
        }

        if (isActiveSelect(selects.departement)) {
            selects.departement.addEventListener('change', async () => {
                if (isActiveSelect(selects.commune)) selects.commune.innerHTML = '<option value="">-- Sélectionner --</option>';
                 if (isActiveSelect(selects.zs)) selects.zs.innerHTML = '<option value="">-- Sélectionner --</option>';
                if (isActiveSelect(selects.zd)) selects.zd.innerHTML = '<option value="">-- Sélectionner --</option>';

                if (selects.departement.value) {
                    await loadOptions(`/api/location/communes?departement=${selects.departement.value}`, 
                                      selects.commune, 'code_commune', 'commune');
                }
                debouncedUpdateCharts();
            });
        }

        if (isActiveSelect(selects.commune)) {
    selects.commune.addEventListener('change', async () => {
        // Réinitialiser les niveaux inférieurs
        if (isActiveSelect(selects.zs)) {
            selects.zs.innerHTML = '<option value="">-- Sélectionner --</option>';
            selects.zs.disabled = false;
        }
        if (isActiveSelect(selects.zd)) {
            selects.zd.innerHTML = '<option value="">-- Sélectionner --</option>';
            selects.zd.disabled = false;
        }

        if (selects.commune.value) {
            console.log('📥 Chargement ZS pour commune:', selects.commune.value);
            await loadOptions(
                `/api/location/zs?commune=${selects.commune.value}`,
                selects.zs,
                'mo_zs',
                'mo_zs'
            );
        }
        // Mettre à jour les graphiques avec ZD vide (données au niveau commune)
        debouncedUpdateCharts();
    });
}


if (isActiveSelect(selects.zs)) {
    selects.zs.addEventListener('change', async () => {
        console.log('🔘 ZS changée:', selects.zs.value);
        
        // Réinitialiser ZD
        if (isActiveSelect(selects.zd)) {
            selects.zd.innerHTML = '<option value="">-- Sélectionner --</option>';
            selects.zd.disabled = false;
        }

        if (selects.zs.value) {
            console.log('Chargement ZD pour ZS:', selects.zs.value);
            await loadOptions(
                `/api/location/zds?zs=${encodeURIComponent(selects.zs.value)}`,
                selects.zd,
                'mo_zd',
                'mo_zd'
            );
        }
        // Ne pas appeler updateCharts ici, car ZD n'a pas encore changé
    });
}

        if (isActiveSelect(selects.zd)) {
            selects.zd.addEventListener('change', () => debouncedUpdateCharts());
        }

        // --- 8. INITIALISATION PAGE ---
        async function initializePage() {
            const userRole = '<%= user.role %>';
            const regionCode = getSelectValue('region');
            const deptCode = getSelectValue('departement');
            const communeCode = getSelectValue('commune');

            console.log('🚀 Init Page. Role:', userRole, 'Codes:', {regionCode, deptCode, communeCode});

            try {
                // Chargement initial pour ROLE_GLOBAL
                if (userRole === 'ROLE_GLOBAL' && isActiveSelect(selects.region)) {
                    if (selects.region.options.length <= 1) {
                         await loadOptions('/api/location/regions', selects.region, 'code_region', 'region');
                    }
                }

                // Chargements en cascade (si les valeurs sont pré-remplies par le contrôleur)
                if (regionCode && isActiveSelect(selects.departement)) {
                     await loadOptions(`/api/location/departements?region=${regionCode}`, 
                                       selects.departement, 'code_departement', 'departement');
                     if (deptCode) selects.departement.value = deptCode;
                }

                if (deptCode && isActiveSelect(selects.commune)) {
                     await loadOptions(`/api/location/communes?departement=${deptCode}`, 
                                       selects.commune, 'code_commune', 'commune');
                     if (communeCode) selects.commune.value = communeCode;
                }

                
                 // --- AJOUT : Charger les ZS si une commune est sélectionnée ---
        if (communeCode && isActiveSelect(selects.zs)) {
            await loadOptions(
                `/api/location/zs?commune=${communeCode}`,
                selects.zs,
                'mo_zs',
                'mo_zs'
            );
            // Optionnel : si une ZS est pré-sélectionnée (ex: via user.defaultZs), la définir ici
            // if (user.defaultZs) selects.zs.value = user.defaultZs;
        }

                if (communeCode && isActiveSelect(selects.zd)) {
                     await loadOptions(`/api/location/zds?commune=${communeCode}`, 
                                       selects.zd, 'mo_zd', 'mo_zd');
                }

                // Chargement des graphiques
                await updateCharts();

            } catch (err) {
                console.error("Erreur initialisation:", err);
            }
        }

setTimeout(() => {
            // Charger les options initiales si nécessaire (ROLE_GLOBAL)
            // Puis updateCharts()
            initializePage();
            updateCharts(); 
        }, 100);
    });
</script>