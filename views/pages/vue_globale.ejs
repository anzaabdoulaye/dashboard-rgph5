function updatePopCollectéVsCartoRegion(dataArray) {
    const ctx = document.getElementById("popChartBarRegions");
    if (!ctx) return;

    // 1. Correction de la récupération des données
    // On reçoit directement le tableau, pas besoin de faire .regionStats
    const regionsData = Array.isArray(dataArray) ? dataArray : [];

    if (regionsData.length === 0) {
        console.warn("Pas de données régionales à afficher");
        return;
    }

    // 2. Préparation des labels et données
    const labelsRegions = regionsData.map(r => r.region);
    const cartoData = regionsData.map(r => r.carto);
    const collecteeData = regionsData.map(r => r.collectee);

    // 3. Gestion de la hauteur dynamique
    // On compte 60px par barre pour que ce soit lisible, avec un min de 300px
    const dynamicHeight = Math.max(300, regionsData.length * 60);
    
    // On applique la hauteur au conteneur PARENT et au Canvas
    ctx.parentNode.style.height = `${dynamicHeight}px`;
    ctx.height = dynamicHeight;

    // 4. Création ou Mise à jour du graphique
    // Si le graphique existe déjà, on le détruit pour éviter les bugs de redimensionnement vertical
    if (charts.barRegions) {
        charts.barRegions.destroy();
    }

    charts.barRegions = new Chart(ctx, {
        type: "bar",
        data: {
            labels: labelsRegions,
            datasets: [
                { 
                    label: "Cartographiée", 
                    data: cartoData, 
                    backgroundColor: "#12A537",
                    barPercentage: 0.7,
                    categoryPercentage: 0.8
                },
                { 
                    label: "Collectée", 
                    data: collecteeData, 
                    backgroundColor: "#F28F00",
                    barPercentage: 0.7,
                    categoryPercentage: 0.8
                }
            ]
        },
        options: {
            indexAxis: "y", // Barres horizontales
            responsive: true,
            maintainAspectRatio: false, // Indispensable pour le scroll vertical
            scales: {
                x: { 
                    beginAtZero: true,
                    grid: { display: true, drawBorder: false }
                },
                y: {
                    grid: { display: false }
                }
            },
            plugins: {
                legend: { position: "top" },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            // Formatage des milliers
                            return context.dataset.label + ": " + Number(context.raw).toLocaleString('fr-FR');
                        }
                    }
                }
            }
        }
    });
}

// D. Évolution cumulative (courbe)
function updateEvolutionChart(evolutionData) {
    const ctx = document.getElementById("evolutionChart");
    if (!ctx) return;

    // Nettoyer toute instance Chart existante sur ce canvas
    let existingChart = Chart.getChart(ctx);
    if (existingChart) {
        existingChart.destroy();
        existingChart = null;
    }

    // Si aucune donnée, on arrête (le canvas est propre)
    if (!Array.isArray(evolutionData) || evolutionData.length === 0) {
        console.warn("⚠️ Aucune donnée d'évolution disponible");
        return;
    }

    // Extraire les labels (dates) et les cumuls
    const labels = evolutionData.map(item => item.date);
    const cumulMenages = evolutionData.map(item => item.cumulMenages);
    const cumulPopulation = evolutionData.map(item => item.cumulPopulation);

    // Créer le nouveau graphique
    charts.evolution = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Ménages cumulés',
                    data: cumulMenages,
                    borderColor: '#12A537',
                    backgroundColor: 'rgba(18, 165, 55, 0.1)',
                    fill: true,
                    tension: 0.1,
                    pointRadius: 2,
                },
                {
                    label: 'Population cumulée',
                    data: cumulPopulation,
                    borderColor: '#F28F00',
                    backgroundColor: 'rgba(242, 143, 0, 0.1)',
                    fill: true,
                    tension: 0.1,
                    pointRadius: 2,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    title: { display: true, text: 'Date' },
                    grid: { display: false }
                },
                y: {
                    title: { display: true, text: 'Cumul' },
                    beginAtZero: true,
                    grid: { display: true }
                }
            },
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + Number(context.raw).toLocaleString('fr-FR');
                        }
                    }
                }
            }
        }
    });
}
