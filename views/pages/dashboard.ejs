<script>  
// Déclarer les variables globales
let regionMap = null;
let departementMap = null;
let regionLayer = null;
let departementLayer = null;
let regionStats = null;
let departementStats = null;
let filteredRegionData = null;
let filteredDepartementData = null;


// Couleurs pour les gradients
const COLOR_SCALES = {
    green: ['#CAEAA9E0', '#6DC645FF', '#54BD41FF', '#36B23DFF', '#12A537FF']
};

// Fonction pour filtrer les données en fonction du rôle
function filterDataByRole(geoData, statsData, userRole, userCode) {
    if (userRole === 'ROLE_GLOBAL') {
        // ROLE_GLOBAL: toutes les données
        return { geoData, statsData };
    }
    
    if (!userCode) {
        console.warn('⚠️ Code utilisateur non défini pour le filtrage');
        return { geoData: { features: [] }, statsData: [] };
    }
    
    if (userRole === 'ROLE_REGIONAL') {
        // ROLE_REGIONAL: seulement la région de l'utilisateur
        const filteredGeo = {
            ...geoData,
            features: geoData.features.filter(feature => 
                feature.properties.code_region === userCode || 
                feature.properties.NOMREG === userCode
            )
        };
        
        const filteredStats = statsData.filter(stat => 
            stat.code === userCode || stat.nom === userCode
        );
        
        return { geoData: filteredGeo, statsData: filteredStats };
    }
    
    if (userRole === 'ROLE_DEPARTEMENTAL') {
        // ROLE_DEPARTEMENTAL: seulement le département de l'utilisateur
        const filteredGeo = {
            ...geoData,
            features: geoData.features.filter(feature => 
                feature.properties.code_departement === userCode || 
                feature.properties.NOMDEP === userCode
            )
        };
        
        const filteredStats = statsData.filter(stat => 
            stat.code === userCode || stat.nom === userCode
        );
        
        return { geoData: filteredGeo, statsData: filteredStats };
    }
    
    // Pour ROLE_COMMUNAL ou autres rôles sans cartes
    return { geoData: { features: [] }, statsData: [] };
}

// Modifier la fonction createBothMaps pour utiliser les versions filtrées
// Fonction principale optimisée pour les rôles
async function createBothMaps() {
    console.log('🗺️ Initialisation des cartes selon les droits...');

    // 1. Vérification de la présence des conteneurs dans le DOM
    const regionContainer = document.getElementById('map-regions');
    const deptContainer = document.getElementById('map-departements');

    const promises = [];
    const mapTypes = [];

    // 2. On prépare uniquement les requêtes nécessaires
    if (regionContainer) {
        console.log('🔹 Chargement carte Régions...');
        promises.push(Promise.all([fetch('/api/regions'), loadRegionStats()]));
        mapTypes.push('region');
    }

    if (deptContainer) {
        console.log('🔹 Chargement carte Départements...');
        promises.push(Promise.all([fetch('/api/departements'), loadDepartementStats()]));
        mapTypes.push('departement');
    }

    if (promises.length === 0) {
        console.log('ℹ️ Aucune carte à afficher pour ce rôle.');
        return;
    }

    try {
        // 3. Exécution parallèle des requêtes requises uniquement
        const results = await Promise.all(promises);

        // 4. Construction des cartes
        for (let i = 0; i < results.length; i++) {
            const [geoResponse, statsData] = results[i];
            const type = mapTypes[i];

            if (!geoResponse.ok) throw new Error(`Erreur chargement données ${type}`);
            const geoData = await geoResponse.json();

            if (type === 'region') {
                createRegionMap(geoData, statsData); // Votre fonction existante
            } else if (type === 'departement') {
                createDepartementMap(geoData, statsData); // Votre fonction existante
            }
        }
        
    } catch (error) {
        console.error('❌ Erreur création cartes:', error);
        // Affiche l'erreur uniquement dans les conteneurs qui existent
        if (regionContainer) showErrorInContainer('map-regions', error);
        if (deptContainer) showErrorInContainer('map-departements', error);
    }
}

// Petite fonction utilitaire pour l'erreur ciblée (remplace votre showError global)
function showErrorInContainer(id, error) {
    const container = document.getElementById(id);
    if (container) {
        container.innerHTML = `<div class="alert alert-danger">Erreur: ${error.message}</div>`;
    }
}
