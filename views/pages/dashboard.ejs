// Fonction pour adapter le zoom en fonction du nombre d'éléments
function adjustMapZoom(map, featuresCount) {
    if (featuresCount === 1) {
        // Si un seul élément, zoomer dessus
        map.setZoom(9, { animate: true });
    } else if (featuresCount <= 3) {
        // Si peu d'éléments, zoom moyen
        map.setZoom(8, { animate: true });
    }
    // Sinon, garder le zoom par défaut
}

